{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClaimGuardContract",
  "description": "Schema definition for typed AI claims and deterministic verification results in Project Sentinel.",
  "definitions": {
    "ClaimProposal": {
      "type": "object",
      "required": [
        "claim_id",
        "case_id",
        "claim_type",
        "predicate",
        "value",
        "evidence_refs",
        "template_id"
      ],
      "properties": {
        "claim_id": { "type": "string" },
        "case_id": { "type": "string" },
        "claim_type": {
          "type": "string",
          "enum": [
            "event_count",
            "finding_exists",
            "rule_match",
            "time_window",
            "entity_observed",
            "case_status",
            "correlation_relationship",
            "data_quality_issue"
          ]
        },
        "predicate": { "type": "string" },
        "value": { "type": "object" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "certainty": {
          "type": "string",
          "enum": ["observed", "inferred", "hypothesis"],
          "default": "observed"
        },
        "template_id": { "type": "string" },
        "proposed_by": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "VerificationCheck": {
      "type": "object",
      "required": ["name", "passed", "reason"],
      "properties": {
        "name": { "type": "string" },
        "passed": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "ClaimVerificationResult": {
      "type": "object",
      "required": [
        "verification_id",
        "claim_id",
        "case_id",
        "status",
        "verification_version",
        "checks",
        "rendered_text",
        "evidence_refs",
        "verified_at"
      ],
      "properties": {
        "verification_id": { "type": "string" },
        "claim_id": { "type": "string" },
        "case_id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["verified", "qualified", "blocked"]
        },
        "verification_version": { "type": "string" },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/definitions/VerificationCheck" }
        },
        "rendered_text": { "type": "string" },
        "qualification_notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocked_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggested_remedy": {
          "type": ["string", "null"]
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "verified_at": { "type": "string" }
      }
    }
  }
}

