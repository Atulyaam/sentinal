# ==============================================================================
# PROJECT SENTINEL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust variables for your target environment.
# Never commit secrets, credentials, or private keys to version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME MODE
# ------------------------------------------------------------------------------
SENTINEL_APP_NAME="Project Sentinel"
SENTINEL_VERSION="0.2.0"

# Target environment: 'development', 'test', or 'production'
SENTINEL_ENV=production

# Public Judge Demo Mode:
# When true, Sentinel runs in isolated synthetic mode:
# - Only approved synthetic fixtures can be executed (Replay Lab)
# - Manual operational file upload and local filesystem scanning are blocked
# - Initial demo baseline is automatically seeded on startup if database is empty
# Defaults to true when SENTINEL_ENV=production
SENTINEL_DEMO_MODE=true

# Automatically seed Scenario A (Suspicious Account Activity) on fresh database startup
SENTINEL_DEMO_SEED=true

# ------------------------------------------------------------------------------
# 2. NETWORKING & SERVER BINDING
# ------------------------------------------------------------------------------
# Host interface to bind server (0.0.0.0 for containers/PaaS, 127.0.0.1 for local)
SENTINEL_HOST=0.0.0.0

# Port to listen on (automatically overridden by PaaS $PORT if present)
PORT=8000
SENTINEL_PORT=8000

# Directory containing built React/Vite static assets (relative or absolute)
# Automatically detected at 'apps/crew-app/dist' if not specified
SENTINEL_STATIC_DIR="./apps/crew-app/dist"

# Security & CORS Configuration
# Comma-separated list of explicitly permitted frontend and host origins (no wildcards)
SENTINEL_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8000,http://localhost:8000

# Optional frontend API URL override (leave empty for same-origin relative URLs in production)
VITE_API_URL=

# ------------------------------------------------------------------------------
# 3. DATABASE & PERSISTENT STORAGE
# ------------------------------------------------------------------------------
# Path to persistent SQLite database file
# In containers/PaaS with persistent volume mounted at /data, set:
SENTINEL_DB_PATH="/data/sentinel.db"
# For local development:
# SENTINEL_DB_PATH="./sentinel.db"

# ------------------------------------------------------------------------------
# 4. SECURITY & RESOURCE LIMITS
# ------------------------------------------------------------------------------
SENTINEL_LOG_LEVEL=INFO

# Maximum allowed import payload size in bytes (default 20MB)
SENTINEL_MAX_IMPORT_SIZE_BYTES=20971520

# Maximum records processed per single file import
SENTINEL_MAX_RECORDS_PER_FILE=100000

# Rate limit for expensive operations (replay execution, correlation, reset)
# Expressed as maximum requests per minute per client IP
SENTINEL_RATE_LIMIT_PER_MINUTE=60

# Operator approved inbox directory (for operational non-demo mode)
# Must point to an explicitly approved directory; system directories are rejected.
SENTINEL_APPROVED_INBOX=./inbox
