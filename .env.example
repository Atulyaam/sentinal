# Project Sentinel — Environment Configuration Template
# Copy to .env for local overrides. Never commit .env or secrets to version control.

# Server Configuration
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000
SENTINEL_ENV=development
SENTINEL_LOG_LEVEL=INFO

# Security & CORS Configuration
# Comma-separated list of explicitly permitted frontend and host origins (no wildcards)
SENTINEL_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5476,http://localhost:5476

# Frontend / Host Integration
VITE_API_URL=http://127.0.0.1:8000

# Security Boundaries (Local-First Inbox - P0 Operator Controlled)
# Must point to an explicitly approved directory; system directories are rejected.
SENTINEL_APPROVED_INBOX=./inbox
